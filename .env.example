# Copy this file to .env (or .env.local) and fill in your own values.
# Vite exposes any variable prefixed with VITE_ to the browser bundle.

# Mapbox public access token (pk.*). Get one from
# https://account.mapbox.com/access-tokens/ and restrict it by URL.
VITE_MAPBOX_ACCESS_TOKEN=

# Supabase browser client config. For local dev, run `npx supabase start`
# and copy the local Project URL / Publishable key from `npx supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Optional overrides.
# VITE_MAPBOX_STYLE_URL=mapbox://styles/mapbox/satellite-streets-v12
# VITE_MAPBOX_DEFAULT_LAT=-28.4793
# VITE_MAPBOX_DEFAULT_LNG=24.6727
# VITE_MAPBOX_DEFAULT_ZOOM=5
